[Desktop Entry]
Type=Application
Name=Wine - UMU
MimeType=application/vnd.microsoft.portable-executable;application/x-msdownload;application/x-ms-dos-executable;application/x-msi;application/x-bat;text/x-ms-regedit;
Exec=sh -c "exec env WINEPREFIX=\"\$HOME/.wine\" PROTONPATH=\"\$HOME/.local/share/Steam/compatibilitytools.d/wine\" umu-run \"\$1\"" sh %f
NoDisplay=true
StartupNotify=true
Icon=wine